{
  "name": "world-of-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simulador geopolítico 2D por turnos para navegador",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/index.html','jugar/WorldOfSystem.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "geo": "tsx scripts/build-geo.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
